{
  "name": "@glaze/desktop",
  "license": "Apache-2.0",
  "author": "GlazeCatTeam",
  "version": "0.1.1",
  "private": true,
  "description": "Electron 桌面应用：主进程、preload、渲染进程外壳",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -w",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "release": "electron-vite build && electron-builder --config electron-builder.yml --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@glaze/contracts": "workspace:*",
    "@glaze/mcp": "workspace:*",
    "@glaze/netease": "workspace:*",
    "@glaze/plugin-account": "workspace:*",
    "@glaze/plugin-analytics": "workspace:*",
    "@glaze/plugin-assistant": "workspace:*",
    "@glaze/plugin-community": "workspace:*",
    "@glaze/plugin-home": "workspace:*",
    "@glaze/plugin-income": "workspace:*",
    "@glaze/plugin-messages": "workspace:*",
    "@glaze/plugin-promotion": "workspace:*",
    "@glaze/plugin-sdk": "workspace:*",
    "@glaze/plugin-settings": "workspace:*",
    "@glaze/plugin-works": "workspace:*",
    "@glaze/storage": "workspace:*",
    "@glaze/theme": "workspace:*",
    "@glaze/theme-fluent-dark": "workspace:*",
    "@glaze/theme-ore-ui": "workspace:*",
    "@glaze/ui": "workspace:*",
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.8",
    "vite": "^8.3.4"
  }
}
