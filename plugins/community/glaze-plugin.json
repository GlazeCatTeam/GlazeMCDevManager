{
  "id": "glaze.community",
  "name": "玩家反馈与评论",
  "version": "0.0.0",
  "publisher": "glaze",
  "description": "玩家反馈、组件评论、回复；侧边栏分为两个入口",
  "engines": {
    "glaze": "^0.1.0"
  },
  "entries": {
    "ui": "src/index.ts"
  },
  "activationEvents": ["onPage:feedback", "onPage:comments"],
  "contributes": {
    "pages": [
      {
        "id": "feedback",
        "title": "玩家反馈"
      },
      {
        "id": "comments",
        "title": "玩家评论"
      }
    ],
    "navItems": [
      {
        "page": "feedback",
        "icon": "nav.feedback",
        "group": "top",
        "order": 50,
        "section": "作品与玩家"
      },
      {
        "page": "comments",
        "icon": "nav.community",
        "group": "top",
        "order": 55,
        "section": "作品与玩家"
      }
    ],
    "widgets": []
  },
  "permissions": ["netease:community.read", "netease:community.write"]
}
