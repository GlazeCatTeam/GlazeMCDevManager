{
  "id": "glaze.theme.ore-ui",
  "name": "Ore UI",
  "version": "0.0.0",
  "description": "基岩版 Ore UI 的方块语言 + 简约：直角、厚底边按钮、单一绿色强调，减少装饰和层级",
  "engines": {
    "glaze": "^0.1.0"
  },
  "defaultVariant": "dark",
  "icons": {
    "set": "icons",
    "style": "pixel"
  },
  "fonts": [],
  "tokens": {
    "base": {
      "gray.950": "#111213",
      "gray.900": "#1B1C1D",
      "gray.850": "#232426",
      "gray.800": "#2B2C2E",
      "gray.750": "#313234",
      "gray.700": "#3A3B3D",
      "gray.600": "#55575A",
      "gray.500": "#77797C",
      "gray.300": "#B9BABC",
      "gray.100": "#F2F2F2",
      "green.700": "#1D4D13",
      "green.600": "#3C8527",
      "green.500": "#5DC137",
      "green.300": "#7FD65C",
      "red.700": "#7E1E1E",
      "red.600": "#C33636",
      "amber.500": "#D99A1E",
      "amber.300": "#FFC44D",
      "gold.400": "#FFD43B"
    },
    "semantic": {
      "surface.app": "{gray.800}",
      "surface.sidebar": "{gray.850}",
      "surface.panel": "{gray.750}",
      "surface.sunken": "{gray.900}",
      "surface.titlebar": "{gray.900}",
      "border.strong": "{gray.950}",
      "border.subtle": "{gray.700}",
      "text.primary": "#FFFFFF",
      "text.muted": "{gray.300}",
      "action.primary.bg": "{green.600}",
      "action.primary.edge": "{green.700}",
      "action.primary.text": "#FFFFFF",
      "action.secondary.bg": "#4A4B4E",
      "action.secondary.edge": "#303133",
      "action.danger.bg": "{red.600}",
      "action.danger.edge": "{red.700}",
      "status.success": "{green.300}",
      "status.warning": "{amber.300}",
      "status.warning.border": "{amber.500}",
      "status.danger": "{red.600}",
      "accent.highlight": "{gold.400}",
      "focus.ring": "#FFFFFF",
      "border.divider": "{surface.app}",
      "text.link": "{green.300}",
      "text.link.hover": "#A6EB87",
      "status.warning.bg": "#2E2A20",
      "trend.up": "{green.300}",
      "trend.down": "#F07A7A",
      "trend.flat": "{gray.500}",
      "progress.fill": "{green.500}",
      "action.primary.hover": "#469A2E",
      "action.secondary.hover": "#56585B",
      "text.danger": "#F07A7A",
      "text.danger.hover": "#FF9C9C",
      "overlay.bg": "rgba(0, 0, 0, 0.6)"
    },
    "component": {
      "radius.control": "0px",
      "radius.panel": "0px",
      "border.width": "2px",
      "button.edgeBottom": "4px",
      "button.height": "40px",
      "panel.padding": "24px",
      "panel.shadow": "none",
      "nav.active.bg": "{action.primary.bg}",
      "nav.active.edgeBottom": "3px",
      "nav.active.edge": "{action.primary.edge}",
      "nav.hover.bg": "#2E2F31",
      "space.unit": "4px",
      "font.family": "\"Noto Sans\", \"Noto Sans SC\", \"Microsoft YaHei UI\", sans-serif",
      "panel.borderColor": "{gray.900}",
      "tag.borderColor": "{gray.600}",
      "menu.shadow": "0 4px 0 {gray.900}",
      "tab.indicator": "{green.500}",
      "switch.knob": "#FFFFFF",
      "dialog.width": "420px",
      "panel.hoverBg": "#383A3C"
    }
  },
  "variants": {
    "dark": {},
    "light": {
      "nav.hover.bg": "#CBCBCE",
      "surface.titlebar": "#CFCFD2",
      "surface.app": "#E6E6E8",
      "surface.sidebar": "#D8D8DB",
      "surface.panel": "#F4F4F5",
      "surface.sunken": "#FFFFFF",
      "border.subtle": "#C4C5C8",
      "text.primary": "#1B1C1D",
      "text.muted": "#55575A",
      "action.secondary.bg": "#D0D1D4",
      "action.secondary.edge": "#A9AAAD",
      "text.link": "{green.600}",
      "text.link.hover": "{green.700}",
      "status.warning.bg": "#FFF4D6",
      "trend.up": "{green.600}",
      "trend.down": "{red.600}",
      "panel.borderColor": "#C4C5C8",
      "tag.borderColor": "#A9AAAD",
      "action.secondary.hover": "#C4C5C8",
      "menu.shadow": "0 4px 0 #C4C5C8",
      "text.danger": "{red.600}",
      "text.danger.hover": "{red.700}",
      "overlay.bg": "rgba(0, 0, 0, 0.35)",
      "panel.hoverBg": "#EAEAEC"
    }
  }
}
